# Copy to .env.local, then rebuild — NEXT_PUBLIC_* values are baked into the
# static bundle at build time, so changing this on the server does nothing.

# Where the contact form posts (src/components/contact/ContactForm.jsx).
# Any service that accepts a cross-origin JSON POST works: Formspree,
# Web3Forms, Getform, a Zapier/Make catch hook, ...
# This URL is visible in the client bundle, so use a submit-only, rate-limited
# endpoint — never a private webhook.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# The Laravel CMS the blog is built from (src/lib/blog.js). Read-only, public,
# and only ever called during `next build` — the exported site never touches it.
# Point this at a staging CMS to preview that content; featured-image URLs
# follow, since their origin is this value minus the trailing /api.
NEXT_PUBLIC_CMS_API=https://cms.launchlaundry.com.my/api
