# Copy to .env.local, then rebuild — NEXT_PUBLIC_* values are baked into the
# static bundle at build time, so changing this on the server does nothing.

# Where the contact form posts (src/components/contact/ContactForm.jsx).
# Any service that accepts a cross-origin JSON POST works: Formspree,
# Web3Forms, Getform, FormSubmit, a Zapier/Make catch hook, ...
# This URL is visible in the client bundle, so use a submit-only, rate-limited
# endpoint — never a private webhook.
#
# LEAD DESTINATION: hijrahpro77@gmail.com
# This build is a static export (next.config.mjs -> output: "export"), so there
# is no server here that can send mail. The destination inbox is configured in
# the form provider's dashboard, NOT in this repo. Set it up once:
#
#   Formspree   - create a form, set the notification email to the address
#                 above, then use https://formspree.io/f/<form-id>
#   Web3Forms   - the access key is bound to the inbox you sign up with; use
#                 https://api.web3forms.com/submit and send access_key
#   FormSubmit  - no signup: https://formsubmit.co/ajax/<your-alias>
#                 First POST emails a one-click activation link to the inbox.
#                 Activate, then swap the raw address for the hashed alias it
#                 gives you — a raw address in this file ends up in the public
#                 JS bundle and will be scraped for spam.
#
# Do not paste the Gmail address straight into this variable.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# The Laravel CMS the blog is built from (src/lib/blog.js). Read-only, public,
# and only ever called during `next build` — the exported site never touches it.
# Point this at a staging CMS to preview that content; featured-image URLs
# follow, since their origin is this value minus the trailing /api.
NEXT_PUBLIC_CMS_API=https://cms.launchlaundry.com.my/api
