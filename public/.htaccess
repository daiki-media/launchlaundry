# Apache / LiteSpeed config for the static export (next build -> ./out).
# It lives in public/ so every build copies it into out/ automatically.
# Upload the CONTENTS of out/ to the web root, this file included.
#
# Next.js emits extensionless URLs as "<route>.html" (about -> about.html), so
# the server has to map one onto the other. Hosts that already do this for you
# (Netlify, Cloudflare Pages, Vercel) ignore this file harmlessly.

# Let the rules below decide what to serve, not Apache's content negotiation.
Options -MultiViews

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html -> / so the homepage has one canonical URL.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Redirect /about.html -> /about so each page keeps a single canonical URL.
  # Matching THE_REQUEST (the literal request line) means the internal rewrite
  # below cannot re-trigger this and loop.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /about from about.html, /products/foo from products/foo.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# The custom 404 page (src/app/not-found.js).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Everything under /_next/static is content-hashed, so it can cache forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must not be cached hard, or a redeploy leaves stale pages behind.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
